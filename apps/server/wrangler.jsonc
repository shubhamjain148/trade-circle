{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trade-circle",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",

  // Required, not optional. Five modules import node:crypto synchronously —
  // src/chat.ts (randomUUID), src/diff/index.ts, src/mcp/normalize.ts,
  // src/poller/source.ts, src/poller/tick.ts and src/auth/vault.ts (hashToken) —
  // and WebCrypto has no synchronous digest to swap them onto. node:crypto is
  // fully supported on Workers under this flag.
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-circle",
      // Placeholder on purpose. The deploy workflow (.github/workflows/deploy.yml)
      // substitutes the D1_DATABASE_ID repo secret at deploy time; for a manual
      // deploy, paste the id printed by `wrangler d1 create` here locally and do
      // not commit it. See docs/DEPLOYMENT.md.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],

  // One room for the whole group — chat fan-out and typing signals, nothing
  // durable (D1 remains the source of truth; see src/room.ts). The class holds
  // WebSockets open with the Hibernation API, so an idle evening of connected
  // tabs bills no duration at all.
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }]
  },

  // `new_sqlite_classes`, not `new_classes`: the key-value backend is Paid-plan
  // only, and SQLite-backed objects are the only kind the free plan can create.
  // The room stores nothing in it — this is about which backend the namespace
  // is created against, and it is the one that exists for us.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],

  // The Vite build output of apps/web. `run_worker_first` keeps /api/* on the
  // Worker; everything else is served straight from the asset store, and an
  // unknown path renders index.html so the hash router can take over.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/__scheduled" is `wrangler dev --test-scheduled`'s hook for firing the
    // cron handler by hand. Without it here the asset router answers first and
    // the cron is untestable locally. Inert in production — Cloudflare invokes
    // scheduled() directly, and a browser hitting the path gets index.html.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },

  // The slots poller/scheduler.ts would have picked, in UTC: pre-open 13:00,
  // the US session hourly from 13:30 to 20:30, and post-close 21:15. Weekdays
  // only. Three triggers against a free-plan allowance of five.
  "triggers": {
    "crons": ["0 13 * * 1-5", "30 13-20 * * 1-5", "15 21 * * 1-5"]
  },

  "vars": {
    "MCP_CLIENT_NAME": "trade-circle",
    // Cloudflare's runtime caps WebCrypto PBKDF2 at 100k iterations (production
    // enforces it; miniflare doesn't). Fine here: the secret is 48 random bytes,
    // so KDF stretching adds little — hardness matters for guessable passwords.
    "VAULT_KDF_ITERATIONS": "100000"

    // Deployment-specific values are deliberately NOT here, so the file can be
    // public and one checkout can serve any group. The deploy workflow passes
    // them with `wrangler deploy --var` from repo secrets; `.dev.vars` supplies
    // them for `wrangler dev`:
    //
    //   APP_URL           https://<worker-name>.<your-subdomain>.workers.dev
    //   VAPID_PUBLIC_KEY  from `pnpm --filter server vapid:generate`
    //   VAPID_SUBJECT     mailto:you@example.com
    //
    // VAPID is all three or none: src/worker.ts refuses a half-configured VAPID
    // rather than shipping an Enable button whose every send silently fails.
    // The keypair is permanent — rotating it invalidates every subscription.
    //
    // MCP_BASE_URL is deliberately NOT here either. A key present in `vars` wins
    // over the same key in .dev.vars, so declaring it would make `wrangler dev`
    // unable to point at a local fake and every local connect attempt would
    // reach the real INDmoney authorization server and register a DCR client
    // there. src/worker.ts defaults it to https://mcp.indmoney.com/mcp instead.
    //
    // Secrets (`wrangler secret put`, never vars): APP_SECRET, VAPID_PRIVATE_KEY.
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
