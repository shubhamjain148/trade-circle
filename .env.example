# Copy to .env and fill in. Never commit the filled-in version.

# Keys the token vault (AES-256-GCM, scrypt-stretched). Required in production;
# in dev the server falls back to a built-in key and says so loudly.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Public origin of the web app. Invite links, the OAuth redirect_uri and the
# post-connect bounce are all built from this — it must match what INDmoney's
# dynamic client registration was given.
APP_URL=http://localhost:5173

# The INDmoney MCP endpoint. Config only: tests and local dev point this at the
# local fake (src/test/fake-mcp-server.ts) and never touch the real host.
MCP_BASE_URL=https://mcp.indmoney.com/mcp

# SQLite file. Anything under a mounted volume in production.
DB_PATH=./data/watcher.db

# API port.
PORT=3001

# Optional. Overrides for the guessed tool names in src/mcp/toolmap.ts — set
# these once the first real connect has written tool_catalog.
# MCP_TOOL_HOLDINGS=networth_holdings
# MCP_TOOL_NETWORTH=networth_snapshot
# MCP_TOOL_HOLDINGS_ARGS={"asset_type":"US_STOCK"}   # enum verified from tool_catalog

# Set to 1 to run the API without the background poll scheduler.
# DISABLE_SCHEDULER=1
